APP_NAME="PaperChat API"

# Standalone ingestion/search only; use an OpenRouter key, separate from chat.
EMBEDDINGS_PROVIDER=openrouter
EMBEDDINGS_MODEL=openai/text-embedding-3-small
OPENROUTER_API_KEY=

# Local Docker defaults. For cloud use the cluster HTTPS URL and API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=paperchat-papers

# Required only for chat; choose a supported OpenRouter chat model ID.
OPENROUTER_MODEL=
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT_SECONDS=60
RAG_RETRIEVAL_TIMEOUT_SECONDS=60
