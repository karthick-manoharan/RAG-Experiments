APP_NAME="PaperChat API"
# Exact origins, JSON list; add the deployed Vercel origin for production.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Shared OpenRouter key for embeddings and chat; never commit a real value.
EMBEDDINGS_PROVIDER=openrouter
EMBEDDINGS_MODEL=openai/text-embedding-3-small
OPENROUTER_API_KEY=

# Local defaults. Production uses the existing HTTPS Qdrant Cloud cluster/key
# and collection, with the SAME embedding model used during ingestion.
# Deployment never recreates or ingests the collection.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=paperchat-papers

# Required only for chat; choose a supported OpenRouter chat model ID.
OPENROUTER_MODEL=
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT_SECONDS=60
RAG_RETRIEVAL_TIMEOUT_SECONDS=60
